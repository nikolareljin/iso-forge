# NikOS profile carried by the Xubuntu 24.04 installer image.
NIKOS_PROFILE_LABEL="NikOS Desktop on Xubuntu 24.04 LTS"
NIKOS_REPO_URL="https://github.com/nikolareljin/nikos"
# Pin the ISO to a released NikOS installer. Use nikos-installer --ref <ref>
# after installation when a different supported release or branch is wanted.
NIKOS_REPO_REF="0.6.5"
